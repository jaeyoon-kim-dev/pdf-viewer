# Optional Docker host port (loopback-only)
PAPERTHREAD_PORT=3080
# When behind your trusted HTTPS reverse proxy, set its exact public hostname.
# VINEXT_TRUSTED_HOSTS=papers.example.com
# Normally the hostname allowlist above is enough; do not enable this on a public raw port.
VINEXT_TRUST_PROXY=0
# For direct Node execution, export DATA_DIR in the shell before db:migrate and start.
# DATA_DIR=/srv/paperthread/data
